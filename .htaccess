# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php83” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php83 .php .php8 .phtml
</IfModule>
<IfModule lsapi_module>
  AddHandler application/x-httpd-ea-php83 .php
</IfModule>
# php -- END cPanel-generated handler, do not edit

<IfModule mod_headers.c>
    Header always set Access-Control-Allow-Origin "*"
    Header always set Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
    Header always set Access-Control-Allow-Headers "Origin, X-Requested-With, Content-Type, Accept, Authorization, Range"
    Header always set Access-Control-Expose-Headers "Content-Length, Content-Range"
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<IfModule lsapi_module>
  php_value upload_max_filesize 256M
  php_value post_max_size 256M
  php_value memory_limit 512M
  php_value max_execution_time 600
  php_value max_input_time 600
</IfModule>
<IfModule mod_php.c>
  php_value upload_max_filesize 256M
  php_value post_max_size 256M
  php_value memory_limit 512M
  php_value max_execution_time 600
  php_value max_input_time 600
</IfModule>
